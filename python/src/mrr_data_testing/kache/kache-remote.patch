--- /dev/null
+++ b/crates/kache-remote/src/test_support.rs
@@ -0,0 +1,53 @@
+use kache_store::{ArtifactPolicy, ArtifactStore, config::Config};
+pub struct TestPolicy;
+impl ArtifactPolicy for TestPolicy {
+    fn allow_hardlink(_: &str) -> bool {
+        false
+    }
+    fn allow_empty(_: &str, _: &[String]) -> bool {
+        true
+    }
+    fn emit_kind(_: &str) -> Option<&'static str> {
+        None
+    }
+    fn stable_after_store(_: &str) -> bool {
+        true
+    }
+}
+pub type Store = ArtifactStore<TestPolicy>;
+/// Build a one-file store entry and return (tmpdir, store, entry_dir).
+pub fn populated_entry() -> (tempfile::TempDir, Store, std::path::PathBuf) {
+    let tmp = tempfile::tempdir().unwrap();
+    let store = Store::open(Config {
+        cache_dir: tmp.path().join("cache"),
+        max_size: 1024 * 1024,
+        gc_evict_shared: false,
+        upload_spool_max_jobs: 16,
+        deferred_durability: false,
+    })
+    .unwrap();
+    let source_dir = tmp.path().join("source");
+    std::fs::create_dir_all(&source_dir).unwrap();
+    let source_file = source_dir.join("libfoo.rlib");
+    std::fs::write(&source_file, b"hello world").unwrap();
+    store
+        .put(
+            "key123",
+            "foo",
+            &["lib".to_string()],
+            &[],
+            "x86_64-unknown-linux-gnu",
+            "debug",
+            &[(source_file, "libfoo.rlib".to_string())],
+            "",
+            "",
+        )
+        .unwrap();
+    let entry_dir = store.entry_dir("key123");
+    (tmp, store, entry_dir)
+}
+
+pub fn process_state_test_lock() -> std::sync::MutexGuard<'static, ()> {
+    static LOCK: std::sync::Mutex<()> = std::sync::Mutex::new(());
+    LOCK.lock().unwrap_or_else(|e| e.into_inner())
+}
